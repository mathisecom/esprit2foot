{%- assign carousel_id = 'e2f-bag-' | append: block.id -%}

<div
  id="e2f-complete-{{ block.id }}"
  class="e2f-complete"
  style="
    --e2f-complete-bg: {{ block.settings.background | default: '#ffffff' }};
    --e2f-complete-text: {{ block.settings.text_color | default: '#111111' }};
    --e2f-complete-accent: {{ block.settings.accent_color | default: '#16e0e0' }};
  "
>
  <div class="e2f-complete__header">
    <div class="e2f-complete__header-text">
      {% if block.settings.title != blank %}
        <div class="e2f-complete__eyebrow">ESPRIT2'FOOT</div>
        <div class="e2f-complete__title">
          {{ block.settings.title }}
        </div>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <div class="e2f-complete__subtitle">
          {{ block.settings.subtitle }}
        </div>
      {% endif %}
    </div>

    {% if block.settings.products.size > 1 %}
      <div class="e2f-complete__arrows">
        <button type="button" class="e2f-complete__arrow e2f-complete__arrow--prev" aria-label="Précédent">
          ←
        </button>

        <button type="button" class="e2f-complete__arrow e2f-complete__arrow--next" aria-label="Suivant">
          →
        </button>
      </div>
    {% endif %}
  </div>

  {% if block.settings.products != blank %}
    <div id="{{ carousel_id }}" class="e2f-complete__track-wrap">
      <div class="e2f-complete__track">
        {% for accessory in block.settings.products %}
          {%- assign current_variant = accessory.selected_or_first_available_variant -%}
          {%- assign form_id = 'e2f-complete-form-' | append: block.id | append: '-' | append: accessory.id -%}

          <div class="e2f-complete__card">
            <div class="e2f-complete__card-inner">
              <a href="{{ accessory.url }}" class="e2f-complete__image-wrap">
                {% if accessory.featured_image %}
                  {{
                    accessory.featured_image
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      widths: '120,180,240,300',
                      class: 'e2f-complete__image',
                      alt: accessory.title
                  }}
                {% else %}
                  <div class="e2f-complete__image-placeholder"></div>
                {% endif %}
              </a>

              <div class="e2f-complete__content">
                <a href="{{ accessory.url }}" class="e2f-complete__product-title">
                  {{ accessory.title }}
                </a>

                <div class="e2f-complete__desc">
                  Complète ton équipement.
                </div>

                <div class="e2f-complete__price">
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="e2f-complete__price-sale">
                      {{ current_variant.price | money }}
                    </span>
                    <span class="e2f-complete__price-compare">
                      {{ current_variant.compare_at_price | money }}
                    </span>
                  {% else %}
                    <span>{{ current_variant.price | money }}</span>
                  {% endif %}
                </div>

                {% form 'product', accessory, id: form_id, class: 'e2f-complete__form' %}
                  {% if accessory.has_only_default_variant %}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                  {% else %}
                    <div class="e2f-complete__actions">
                      <select name="id" class="e2f-complete__select">
                        {% for variant in accessory.variants %}
                          <option
                            value="{{ variant.id }}"
                            {% if variant.id == current_variant.id %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}
                          >
                            {{ variant.title }}
                          </option>
                        {% endfor %}
                      </select>

                      <button
                        type="submit"
                        class="e2f-complete__add-btn"
                        {% unless current_variant.available %}disabled{% endunless %}
                        aria-label="Ajouter {{ accessory.title }}"
                      >
                        +
                      </button>
                    </div>
                  {% endif %}

                  {% if accessory.has_only_default_variant %}
                    <div class="e2f-complete__actions e2f-complete__actions--single">
                      <div class="e2f-complete__spacer"></div>

                      <button
                        type="submit"
                        class="e2f-complete__add-btn"
                        {% unless current_variant.available %}disabled{% endunless %}
                        aria-label="Ajouter {{ accessory.title }}"
                      >
                        +
                      </button>
                    </div>
                  {% endif %}
                {% endform %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="e2f-complete__empty">
      Sélectionne tes accessoires dans les réglages du bloc.
    </div>
  {% endif %}
</div>

<style>
  #e2f-complete-{{ block.id }} {
    width: 100%;
    padding: 18px 0 20px;
    border-top: 1px solid rgba(0,0,0,.10);
    border-bottom: 1px solid rgba(0,0,0,.10);
    color: var(--e2f-complete-text);
  }

  #e2f-complete-{{ block.id }} * {
    box-sizing: border-box;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 16px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__eyebrow {
    color: var(--e2f-complete-accent);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 4px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__title {
    font-size: 28px;
    line-height: .95;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -.03em;
    margin-bottom: 8px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__subtitle {
    color: #767676;
    font-size: 14px;
    line-height: 1.35;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__arrows {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__arrow {
    width: 36px;
    height: 36px;
    border: 1px solid #d9d9d9;
    background: #fff;
    color: #111;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    transition: .2s ease;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__arrow:hover {
    background: var(--e2f-complete-accent);
    border-color: var(--e2f-complete-accent);
    color: #000;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__track-wrap {
    overflow: hidden;
    width: 100%;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__track::-webkit-scrollbar {
    display: none;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__card {
    flex: 0 0 295px;
    min-width: 295px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__card-inner {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    height: 100%;
    background: #fff;
    border: 1px solid #dddddd;
    padding: 10px;
    min-height: 148px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__image-wrap {
    width: 92px;
    min-width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    text-decoration: none;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__image-placeholder {
    width: 100%;
    height: 100%;
    background: #efefef;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__product-title {
    font-size: 14px;
    line-height: 1.2;
    font-weight: 800;
    color: #111;
    text-decoration: none;
    margin-bottom: 4px;
    display: block;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__desc {
    font-size: 11px;
    line-height: 1.35;
    color: #8a8a8a;
    margin-bottom: 8px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__price {
    font-size: 14px;
    font-weight: 800;
    color: #111;
    margin-bottom: 12px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__price-sale {
    color: #111;
    margin-right: 6px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__price-compare {
    color: #999;
    font-weight: 500;
    text-decoration: line-through;
    font-size: 12px;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__form {
    margin-top: auto;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__actions {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin-top: auto;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__actions--single {
    justify-content: flex-end;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__spacer {
    flex: 1;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__select {
    flex: 1;
    min-width: 0;
    height: 40px;
    border: 1px solid #d8d8d8;
    background: #fff;
    color: #111;
    font-size: 13px;
    padding: 0 12px;
    outline: none;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__add-btn {
    width: 40px;
    min-width: 40px;
    height: 40px;
    border: 0;
    background: var(--e2f-complete-accent);
    color: #000;
    font-size: 22px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .15s ease, opacity .15s ease;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__add-btn:hover {
    transform: translateY(-1px);
  }

  #e2f-complete-{{ block.id }} .e2f-complete__add-btn:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  #e2f-complete-{{ block.id }} .e2f-complete__empty {
    padding: 20px;
    border: 1px dashed #cccccc;
    color: #777;
    font-size: 12px;
    text-align: center;
  }

  @media screen and (max-width: 999px) {
    #e2f-complete-{{ block.id }} .e2f-complete__title {
      font-size: 24px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__card {
      flex: 0 0 280px;
      min-width: 280px;
    }
  }

  @media screen and (max-width: 699px) {
    #e2f-complete-{{ block.id }} {
      padding: 14px 0 16px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__header {
      margin-bottom: 12px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__title {
      font-size: 21px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__subtitle {
      font-size: 12px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__arrows {
      display: none;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__card {
      flex: 0 0 88%;
      min-width: 88%;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__card-inner {
      min-height: 140px;
    }

    #e2f-complete-{{ block.id }} .e2f-complete__image-wrap {
      width: 84px;
      min-width: 84px;
      height: 84px;
    }
  }
</style>

<script>
  (function() {
    var root = document.getElementById('e2f-complete-{{ block.id }}');
    if (!root) return;

    var track = root.querySelector('.e2f-complete__track');
    var prev = root.querySelector('.e2f-complete__arrow--prev');
    var next = root.querySelector('.e2f-complete__arrow--next');

    if (!track || !prev || !next) return;

    var getScrollAmount = function() {
      var card = track.querySelector('.e2f-complete__card');
      if (!card) return 300;
      return card.offsetWidth + 12;
    };

    prev.addEventListener('click', function() {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    next.addEventListener('click', function() {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  })();
</script>