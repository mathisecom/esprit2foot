{%- assign carousel_id = 'e2f-bag-' | append: block.id -%}

<div
  id="e2f-complete-{{ block.id }}"
  class="e2f-complete"
  style="
    --e2f-complete-bg: {{ block.settings.background }};
    --e2f-complete-text: {{ block.settings.text_color }};
    --e2f-complete-accent: {{ block.settings.accent_color }};
  "
>

  <div class="e2f-complete__header">

    <div>
      {% if block.settings.title != blank %}
        <div class="e2f-complete__title">
          {{ block.settings.title }}
        </div>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <div class="e2f-complete__subtitle">
          {{ block.settings.subtitle }}
        </div>
      {% endif %}
    </div>


    {% if block.settings.products.size > 1 %}
      <div class="e2f-complete__arrows">

        <button
          is="prev-button"
          class="e2f-complete__arrow"
          aria-controls="{{ carousel_id }}"
          aria-label="Précédent"
          disabled
        >
          ←
        </button>

        <button
          is="next-button"
          class="e2f-complete__arrow"
          aria-controls="{{ carousel_id }}"
          aria-label="Suivant"
        >
          →
        </button>

      </div>
    {% endif %}

  </div>


  {% if block.settings.products != blank %}

    <scroll-carousel
      selector=".horizontal-product"
      id="{{ carousel_id }}"
      class="e2f-complete__carousel scroll-area"
    >

      <div class="e2f-complete__products">

        {% for accessory in block.settings.products %}

          <div class="e2f-complete__product">

            {% render 'horizontal-product',
              product: accessory,
              show_add_to_cart: true,
              background: block.settings.background,
              text_color: block.settings.text_color
            %}

          </div>

        {% endfor %}

      </div>

    </scroll-carousel>

  {% else %}

    <div class="e2f-complete__empty">
      Sélectionne tes accessoires dans les réglages du bloc.
    </div>

  {% endif %}

</div>


<style>

  #e2f-complete-{{ block.id }} {
    width: 100%;

    padding: 15px 0;

    border-top: 1px solid rgba(0,0,0,.12);
    border-bottom: 1px solid rgba(0,0,0,.12);
  }


  #e2f-complete-{{ block.id }} .e2f-complete__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 10px;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__title {
    position: relative;

    padding-left: 10px;

    color: var(--e2f-complete-text);

    font-size: 13px;
    line-height: 1;

    font-weight: 900;

    letter-spacing: -.02em;

    text-transform: uppercase;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__title::before {
    content: "";

    position: absolute;

    left: 0;
    top: 1px;

    width: 3px;
    height: 11px;

    background: var(--e2f-complete-accent);
  }


  #e2f-complete-{{ block.id }} .e2f-complete__subtitle {
    margin-top: 5px;

    color: #777;

    font-size: 9px;
    line-height: 1.3;
  }


  /* FLÈCHES */

  #e2f-complete-{{ block.id }} .e2f-complete__arrows {
    display: flex;

    gap: 4px;

    flex-shrink: 0;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow {
    appearance: none !important;

    width: 29px !important;
    height: 29px !important;

    min-width: 29px !important;

    display: flex !important;
    align-items: center;
    justify-content: center;

    padding: 0 !important;
    margin: 0 !important;

    background: transparent !important;

    color: var(--e2f-complete-text) !important;

    border: 1px solid rgba(0,0,0,.2) !important;
    border-radius: 0 !important;

    box-shadow: none !important;

    font-size: 13px;

    cursor: pointer;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow::before,
  #e2f-complete-{{ block.id }} .e2f-complete__arrow::after {
    display: none !important;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow:hover {
    background: var(--e2f-complete-accent) !important;

    border-color: var(--e2f-complete-accent) !important;

    color: #000 !important;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow:disabled {
    opacity: .3;
  }


  /* PRODUITS */

  #e2f-complete-{{ block.id }} .e2f-complete__carousel {
    width: 100%;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__products {
    display: flex;

    gap: 8px;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__product {
    flex: 0 0 255px;

    min-width: 255px;
  }


  #e2f-complete-{{ block.id }} .horizontal-product {
    height: 100%;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__empty {
    padding: 18px;

    border: 1px dashed #ccc;

    color: #777;

    font-size: 10px;

    text-align: center;
  }


  @media screen and (max-width: 699px) {

    #e2f-complete-{{ block.id }} .e2f-complete__arrows {
      display: none;
    }


    #e2f-complete-{{ block.id }} .e2f-complete__products {
      gap: 7px;
    }


    #e2f-complete-{{ block.id }} .e2f-complete__product {
      flex-basis: 78%;

      min-width: 78%;
    }

  }

</style>