{%- assign carousel_id = 'e2f-bag-' | append: block.id -%}

<div
  id="e2f-complete-{{ block.id }}"
  class="e2f-complete"
  style="
    --e2f-complete-bg: {{ block.settings.background }};
    --e2f-complete-text: {{ block.settings.text_color }};
    --e2f-complete-accent: {{ block.settings.accent_color }};
  "
>

  <div class="e2f-complete__header">

    <div>
      {% if block.settings.title != blank %}
        <div class="e2f-complete__title">
          {{ block.settings.title }}
        </div>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <div class="e2f-complete__subtitle">
          {{ block.settings.subtitle }}
        </div>
      {% endif %}
    </div>


    {% if block.settings.products.size > 1 %}
      <div class="e2f-complete__arrows">

        <button
          is="prev-button"
          type="button"
          class="e2f-complete__arrow"
          aria-controls="{{ carousel_id }}"
          aria-label="Précédent"
          disabled
        >
          ←
        </button>

        <button
          is="next-button"
          type="button"
          class="e2f-complete__arrow"
          aria-controls="{{ carousel_id }}"
          aria-label="Suivant"
        >
          →
        </button>

      </div>
    {% endif %}

  </div>


  {% if block.settings.products != blank %}

    <scroll-carousel
      selector=".horizontal-product"
      id="{{ carousel_id }}"
      class="e2f-complete__carousel scroll-area"
    >

      <div class="e2f-complete__products">

        {% for accessory in block.settings.products %}

          <div class="e2f-complete__product">

            {% render 'horizontal-product',
              product: accessory,
              show_add_to_cart: true,
              background: block.settings.background,
              text_color: block.settings.text_color
            %}

          </div>

        {% endfor %}

      </div>

    </scroll-carousel>

  {% else %}

    <div class="e2f-complete__empty">
      Sélectionne tes accessoires dans les réglages du bloc.
    </div>

  {% endif %}

</div>


<style>

  /* ===============================
     WRAPPER
  =============================== */

  #e2f-complete-{{ block.id }} {
    width: 100%;

    padding: 16px 0 18px;

    border-top:
      1px solid rgba(0,0,0,.12);

    border-bottom:
      1px solid rgba(0,0,0,.12);
  }


  #e2f-complete-{{ block.id }} * {
    box-sizing: border-box;
  }


  /* ===============================
     HEADER
  =============================== */

  #e2f-complete-{{ block.id }} .e2f-complete__header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 11px;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__title {
    position: relative;

    padding-left: 10px;

    color:
      var(--e2f-complete-text);

    font-size: 13px;

    line-height: 1;

    font-weight: 900;

    letter-spacing: -.02em;

    text-transform: uppercase;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__title::before {
    content: "";

    position: absolute;

    left: 0;
    top: 1px;

    width: 3px;
    height: 11px;

    background:
      var(--e2f-complete-accent);
  }


  #e2f-complete-{{ block.id }} .e2f-complete__subtitle {
    margin-top: 5px;

    color: #777;

    font-size: 9px;

    line-height: 1.3;
  }


  /* ===============================
     FLÈCHES
  =============================== */

  #e2f-complete-{{ block.id }} .e2f-complete__arrows {
    display: flex;

    gap: 5px;

    flex-shrink: 0;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow {
    appearance: none !important;
    -webkit-appearance: none !important;

    width: 30px !important;
    height: 30px !important;

    min-width: 30px !important;
    min-height: 30px !important;

    display: flex !important;

    align-items: center;
    justify-content: center;

    padding: 0 !important;
    margin: 0 !important;

    background:
      transparent !important;

    color:
      var(--e2f-complete-text) !important;

    border:
      1px solid rgba(0,0,0,.2) !important;

    border-radius: 0 !important;

    box-shadow: none !important;

    font-size: 13px;

    cursor: pointer;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow::before,
  #e2f-complete-{{ block.id }} .e2f-complete__arrow::after {
    display: none !important;

    content: none !important;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow:hover {
    background:
      var(--e2f-complete-accent) !important;

    border-color:
      var(--e2f-complete-accent) !important;

    color: #000 !important;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__arrow:disabled {
    opacity: .28;

    cursor: default;
  }


  /* ===============================
     CAROUSEL
  =============================== */

  #e2f-complete-{{ block.id }} .e2f-complete__carousel {
    width: 100%;

    overflow: hidden;
  }


  #e2f-complete-{{ block.id }} .e2f-complete__products {
    display: flex;

    gap: 10px;

    align-items: stretch;
  }


  /* IMPORTANT :
     330px au lieu de 255px
  */

  #e2f-complete-{{ block.id }} .e2f-complete__product {
    flex: 0 0 260px;

    min-width: 330px;

    display: flex;
  }


  /* ===============================
     PRODUIT NATIF DU THÈME
  =============================== */

  #e2f-complete-{{ block.id }} .horizontal-product {
    width: 100%;

    min-height: 118px;

    height: auto;

    flex: 1;

    position: relative;

    overflow: visible;
  }


  /*
    On donne plus d'air au contenu
    pour éviter que le bouton passe
    par-dessus le titre.
  */

  #e2f-complete-{{ block.id }} .horizontal-product__info,
  #e2f-complete-{{ block.id }} .horizontal-product__details,
  #e2f-complete-{{ block.id }} .horizontal-product__content {
    min-width: 0;

    padding-right: 6px;
  }


  /*
    Les titres trop longs restent
    propres sur 2 lignes max.
  */

  #e2f-complete-{{ block.id }}
  .horizontal-product a {
    overflow-wrap: anywhere;
  }


  /*
    Bouton natif :
    on empêche qu'il déborde
    sur le texte.
  */

  #e2f-complete-{{ block.id }}
  .horizontal-product button {

    flex-shrink: 0;
  }


  /* ===============================
     EMPTY
  =============================== */

  #e2f-complete-{{ block.id }} .e2f-complete__empty {
    width: 100%;

    padding: 20px;

    border:
      1px dashed #ccc;

    color: #777;

    font-size: 10px;

    text-align: center;
  }


  /* ===============================
     TABLETTE
  =============================== */

  @media screen and (max-width: 1100px) {

    #e2f-complete-{{ block.id }} .e2f-complete__product {
      flex-basis: 310px;

      min-width: 310px;
    }

  }


  /* ===============================
     MOBILE
  =============================== */

  @media screen and (max-width: 699px) {

    #e2f-complete-{{ block.id }} {
      padding:
        14px 0 16px;
    }


    #e2f-complete-{{ block.id }} .e2f-complete__arrows {
      display: none;
    }


    #e2f-complete-{{ block.id }} .e2f-complete__products {
      gap: 8px;
    }


    /*
      Sur téléphone on laisse
      presque toute la largeur.
    */

    #e2f-complete-{{ block.id }} .e2f-complete__product {
      flex:
        0 0 88%;

      min-width:
        88%;
    }


    #e2f-complete-{{ block.id }} .horizontal-product {
      min-height: 110px;
    }

  }

</style>