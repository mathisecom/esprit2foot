<section
  id="e2f-reviews-{{ section.id }}"
  class="e2f-reviews"
  style="
    --e2f-bg: {{ section.settings.background }};
    --e2f-card: {{ section.settings.card_background }};
    --e2f-text: {{ section.settings.text_color }};
    --e2f-muted: {{ section.settings.muted_color }};
    --e2f-accent: {{ section.settings.accent_color }};
  "
>
  <div class="e2f-reviews__inner">

    <!-- HEADER -->
    <div class="e2f-reviews__top">

      <div class="e2f-reviews__titles">

        {% if section.settings.eyebrow != blank %}
          <div class="e2f-reviews__eyebrow">
            <span class="e2f-reviews__eyebrow-line"></span>
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h2 class="e2f-reviews__heading">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.heading_accent != blank %}
          <div class="e2f-reviews__heading-accent">
            {{ section.settings.heading_accent }}
          </div>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="e2f-reviews__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}

      </div>


      {% if section.blocks.size > 1 %}
        <div class="e2f-reviews__arrows">
          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-prev="{{ section.id }}"
            aria-label="Avis précédent"
          >
            ←
          </button>

          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-next="{{ section.id }}"
            aria-label="Avis suivant"
          >
            →
          </button>
        </div>
      {% endif %}

    </div>


    <!-- CONTENU -->
    <div class="e2f-reviews__content">

      <!-- SCORE -->
      <aside class="e2f-score">

        <div class="e2f-score__line"></div>

        {% if section.settings.score_label != blank %}
          <div class="e2f-score__label">
            {{ section.settings.score_label }}
          </div>
        {% endif %}

        <div class="e2f-score__number">
          {{ section.settings.rating }}
          <span>/5</span>
        </div>

        <div class="e2f-score__stars">
          ★★★★★
        </div>

        {% if section.settings.rating_text != blank %}
          <p class="e2f-score__text">
            {{ section.settings.rating_text }}
          </p>
        {% endif %}

        {% if section.settings.review_count != blank %}
          <div class="e2f-score__count">
            {{ section.settings.review_count }}
          </div>
        {% endif %}


        {% if section.settings.brand_logo != blank %}
          <div class="e2f-score__logo">
            {{
              section.settings.brand_logo
              | image_url: width: 500
              | image_tag:
                loading: 'lazy',
                class: 'e2f-score__logo-image'
            }}
          </div>
        {% endif %}

      </aside>


      <!-- SLIDER -->
      <div
        class="e2f-reviews__track"
        id="e2f-review-track-{{ section.id }}"
      >

        {% for block in section.blocks %}

          <article
            class="e2f-review-card"
            {{ block.shopify_attributes }}
          >

            <!-- MEDIA -->
            <div class="e2f-review-card__media">

              <div class="e2f-review-card__number">
                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
              </div>

              {% if block.settings.video != blank %}

                {{
                  block.settings.video
                  | video_tag:
                    controls: true,
                    muted: true,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'e2f-review-card__video'
                }}

                <div class="e2f-review-card__type">
                  VIDÉO PLAYER
                </div>

              {% elsif block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 1000',
                    sizes: '(max-width: 749px) 82vw, 340px',
                    class: 'e2f-review-card__image'
                }}

                <div class="e2f-review-card__type">
                  PHOTO PLAYER
                </div>

              {% else %}

                <div class="e2f-review-card__placeholder">
                  <span class="e2f-review-card__placeholder-plus">+</span>
                  <strong>AJOUTE TON MÉDIA</strong>
                  <small>Photo ou vidéo client</small>
                </div>

              {% endif %}

            </div>


            <!-- BODY -->
            <div class="e2f-review-card__body">

              <div class="e2f-review-card__topline">

                <div class="e2f-review-card__stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.stars %}
                      ★
                    {% else %}
                      ☆
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.verified %}
                  <span class="e2f-review-card__verified">
                    ✓ ACHAT VÉRIFIÉ
                  </span>
                {% endif %}

              </div>


              {% if block.settings.review != blank %}
                <div class="e2f-review-card__review">
                  {{ block.settings.review }}
                </div>
              {% endif %}


              <div class="e2f-review-card__customer">

                <div class="e2f-review-card__avatar">
                  {{ block.settings.name | slice: 0, 1 | upcase }}
                </div>

                <div class="e2f-review-card__customer-text">

                  {% if block.settings.name != blank %}
                    <strong>
                      {{ block.settings.name }}
                    </strong>
                  {% endif %}

                  {% if block.settings.product_name != blank %}
                    <span>
                      {{ block.settings.product_name }}
                    </span>
                  {% endif %}

                </div>

              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>
  /* =========================================
     BASE
  ========================================= */

  #e2f-reviews-{{ section.id }} {
    width: 100%;
    overflow: hidden;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    background: var(--e2f-bg);
    color: var(--e2f-text);
  }

  #e2f-reviews-{{ section.id }} * {
    box-sizing: border-box;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
    width: min(1500px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* =========================================
     HEADER
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-reviews__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 34px;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__eyebrow {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 13px;

    color: var(--e2f-accent);

    font-size: 11px;
    line-height: 1;

    font-weight: 800;

    letter-spacing: .17em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__eyebrow-line {
    width: 26px;
    height: 2px;

    display: block;

    background: var(--e2f-accent);
  }


  #e2f-reviews-{{ section.id }} .e2f-reviews__heading {
    margin: 0;

    color: var(--e2f-text);

    font-family:
      var(--text-font-family),
      Arial,
      Helvetica,
      sans-serif;

    font-size: clamp(36px, 4.1vw, 66px);

    line-height: .94;

    font-weight: 900;

    letter-spacing: -.055em;
    text-transform: uppercase;
  }


  /*
    Partie turquoise volontairement séparée :
    moins proche du style "mot en italique dans le titre"
  */

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading-accent {
    position: relative;

    display: inline-block;

    margin-top: 5px;

    color: var(--e2f-accent);

    font-family:
      var(--text-font-family),
      Arial,
      Helvetica,
      sans-serif;

    font-size: clamp(36px, 4.1vw, 66px);

    line-height: .94;

    font-weight: 900;

    letter-spacing: -.055em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading-accent::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -10px;

    width: 72px;
    height: 3px;

    background: var(--e2f-accent);
  }


  #e2f-reviews-{{ section.id }} .e2f-reviews__subtitle {
    max-width: 620px;

    margin: 24px 0 0;

    color: var(--e2f-muted);

    font-size: 13px;
    line-height: 1.55;
  }


  /* =========================================
     FLÈCHES
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
    display: flex;

    gap: 8px;

    flex-shrink: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid rgba(8, 8, 8, 1);

    background: black;
    color: rgba(0, 0, 0, 1)000ff;

    font-size: 18px;

    cursor: pointer;

    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow:hover {
    background: var(--e2f-accent);
    border-color: var(--e2f-accent);

    color: #000000ff;
  }


  /* =========================================
     LAYOUT PRINCIPAL
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-reviews__content {
    display: grid;

    grid-template-columns: 220px minmax(0, 1fr);

    gap: 14px;

    align-items: stretch;
  }


  /* =========================================
     SCORE
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-score {
    position: relative;

    min-height: 520px;

    padding: 27px 22px 22px;

    display: flex;
    flex-direction: column;

    background: #050606;

    border:
      1px solid rgba(255,255,255,.10);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__line {
    position: absolute;

    top: -1px;
    left: -1px;

    width: 5px;
    height: 120px;

    background: var(--e2f-accent);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__label {
    margin-bottom: 20px;

    color: var(--e2f-accent);

    font-size: 10px;
    line-height: 1;

    font-weight: 850;

    letter-spacing: .15em;

    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number {
    color: #fff;

    font-size: 72px;
    line-height: .88;

    font-weight: 900;

    letter-spacing: -.08em;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number span {
    margin-left: 4px;

    color: var(--e2f-accent);

    font-size: 20px;

    letter-spacing: -.02em;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__stars {
    margin-top: 25px;

    color: #ffb000;

    font-size: 18px;

    letter-spacing: 2px;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__text {
    margin: 13px 0 0;

    color: #8f8f8f;

    font-size: 11px;
    line-height: 1.5;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__count {
    margin-top: 9px;

    color: #fff;

    font-size: 13px;
    line-height: 1.3;

    font-weight: 750;
  }


  /* LOGO */

  #e2f-reviews-{{ section.id }} .e2f-score__logo {
    margin-top: auto;

    padding-top: 26px;

    border-top: 1px solid rgba(255,255,255,.10);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__logo-image {
    display: block;

    width: {{ section.settings.logo_width }}px;

    max-width: 100%;

    height: auto;

    object-fit: contain;

    object-position: left center;
  }


  /* =========================================
     SLIDER
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-reviews__track {
    min-width: 0;

    display: grid;

    grid-auto-flow: column;

    grid-auto-columns:
      minmax(290px, 335px);

    gap: 10px;

    overflow-x: auto;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    scrollbar-width: none;

    overscroll-behavior-inline: contain;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__track::-webkit-scrollbar {
    display: none;
  }


  /* =========================================
     CARTES
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-review-card {
    min-width: 0;

    background: var(--e2f-card);

    color: #fff;

    border: 1px solid rgba(255,255,255,.12);

    scroll-snap-align: start;
  }


  /* MEDIA */

  #e2f-reviews-{{ section.id }} .e2f-review-card__media {
    position: relative;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: #141414;

    border-bottom:
      1px solid rgba(255,255,255,.10);
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__image,
  #e2f-reviews-{{ section.id }} .e2f-review-card__video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* NUMÉRO */

  #e2f-reviews-{{ section.id }} .e2f-review-card__number {
    position: absolute;

    z-index: 5;

    top: 12px;
    right: 13px;

    color: rgba(255,255,255,.82);

    font-size: 10px;
    line-height: 1;

    font-weight: 850;

    letter-spacing: .14em;

    text-shadow:
      0 1px 5px rgba(0,0,0,.5);
  }


  /* LABEL PHOTO / VIDEO */

  #e2f-reviews-{{ section.id }} .e2f-review-card__type {
    position: absolute;

    z-index: 5;

    left: 0;
    bottom: 0;

    padding: 7px 11px;

    background: var(--e2f-accent);

    color: #050505;

    font-size: 9px;
    line-height: 1;

    font-weight: 900;

    letter-spacing: .1em;

    text-transform: uppercase;
  }


  /* PLACEHOLDER */

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 5px;

    color: #777;

    text-align: center;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder-plus {
    color: var(--e2f-accent);

    font-size: 35px;
    line-height: 1;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder strong {
    margin-top: 6px;

    color: #aaa;

    font-size: 11px;

    letter-spacing: .09em;

    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder small {
    color: #666;

    font-size: 10px;
  }


  /* =========================================
     CONTENU AVIS
  ========================================= */

  #e2f-reviews-{{ section.id }} .e2f-review-card__body {
    padding: 17px 16px 18px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__topline {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 13px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__stars {
    color: #ffb000;

    font-size: 13px;
    line-height: 1;

    letter-spacing: 1px;

    white-space: nowrap;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__verified {
    color: var(--e2f-accent);

    font-size: 8px;
    line-height: 1;

    font-weight: 850;

    letter-spacing: .07em;

    text-transform: uppercase;

    white-space: nowrap;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review {
    min-height: 70px;

    color: #ffffffff;

    font-size: 14px;
    line-height: 1.5;

    font-weight: 600;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review p {
    margin: 0;
  }


  /* CLIENT */

  #e2f-reviews-{{ section.id }} .e2f-review-card__customer {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 20px;

    padding-top: 14px;

    border-top:
      1px solid rgba(255,255,255,.11);
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__avatar {
    width: 31px;
    height: 31px;

    flex: 0 0 31px;

    display: flex;

    align-items: center;
    justify-content: center;

    background: var(--e2f-accent);

    color: #050505;

    font-size: 11px;

    font-weight: 900;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__customer-text {
    min-width: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__customer-text strong {
    display: block;

    color: #fff;

    font-size: 12px;
    line-height: 1.2;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__customer-text span {
    display: block;

    margin-top: 3px;

    color: #777;

    font-size: 9px;
    line-height: 1.3;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #e2f-reviews-{{ section.id }} {
      padding-top:
        {{ section.settings.mobile_padding_top }}px;

      padding-bottom:
        {{ section.settings.mobile_padding_bottom }}px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
      width: calc(100% - 24px);
    }


    /* HEADER */

    #e2f-reviews-{{ section.id }} .e2f-reviews__top {
      margin-bottom: 24px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading,
    #e2f-reviews-{{ section.id }} .e2f-reviews__heading-accent {
      font-size:
        clamp(31px, 10vw, 44px);
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading-accent::after {
      bottom: -8px;

      width: 50px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__subtitle {
      margin-top: 20px;

      font-size: 12px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
      display: none;
    }


    /* SCORE */

    #e2f-reviews-{{ section.id }} .e2f-reviews__content {
      display: block;
    }

    #e2f-reviews-{{ section.id }} .e2f-score {
      min-height: auto;

      display: grid;

      grid-template-columns:
        auto 1fr;

      column-gap: 18px;
      row-gap: 5px;

      margin-bottom: 13px;

      padding: 18px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__line {
      height: 100%;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__label {
      grid-column: 1 / -1;

      margin-bottom: 8px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__number {
      grid-row: 2 / 5;

      font-size: 52px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__stars {
      align-self: end;

      margin: 0;

      font-size: 15px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__text {
      margin: 0;

      font-size: 10px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__count {
      margin: 0;

      font-size: 11px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__logo {
      display: none;
    }


    /* SLIDER */

    #e2f-reviews-{{ section.id }} .e2f-reviews__track {
      width: calc(100vw - 12px);

      margin-right: -12px;

      padding-right: 24px;

      grid-auto-columns: 82vw;

      gap: 9px;
    }


    /* CARD */

    #e2f-reviews-{{ section.id }} .e2f-review-card__body {
      padding: 14px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__review {
      min-height: 60px;

      font-size: 13px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__verified {
      font-size: 7px;
    }

  }
</style>


<script>
  (function () {

    function initE2FReviews() {

      var root = document.getElementById(
        'e2f-reviews-{{ section.id }}'
      );

      if (!root) return;


      var track = root.querySelector(
        '#e2f-review-track-{{ section.id }}'
      );

      var prev = root.querySelector(
        '[data-e2f-prev="{{ section.id }}"]'
      );

      var next = root.querySelector(
        '[data-e2f-next="{{ section.id }}"]'
      );


      if (!track) return;


      function getScrollAmount() {

        var card =
          track.querySelector('.e2f-review-card');

        if (!card) return 340;

        return
          card.getBoundingClientRect().width + 10;
      }


      if (prev && !prev.dataset.e2fReady) {

        prev.dataset.e2fReady = 'true';

        prev.addEventListener(
          'click',
          function () {

            var card =
              track.querySelector(
                '.e2f-review-card'
              );

            var amount =
              card
                ? card.getBoundingClientRect().width + 10
                : 340;

            track.scrollBy({
              left: -amount,
              behavior: 'smooth'
            });

          }
        );
      }


      if (next && !next.dataset.e2fReady) {

        next.dataset.e2fReady = 'true';

        next.addEventListener(
          'click',
          function () {

            var card =
              track.querySelector(
                '.e2f-review-card'
              );

            var amount =
              card
                ? card.getBoundingClientRect().width + 10
                : 340;

            track.scrollBy({
              left: amount,
              behavior: 'smooth'
            });

          }
        );
      }

    }


    if (document.readyState === 'loading') {

      document.addEventListener(
        'DOMContentLoaded',
        initE2FReviews
      );

    } else {

      initE2FReviews();

    }


    document.addEventListener(
      'shopify:section:load',
      initE2FReviews
    );

  })();
</script>


{% schema %}
{
  "name": "E2F - Retours Players V3",
  "tag": "section",
