<section
  id="e2f-reviews-{{ section.id }}"
  class="e2f-reviews"
  style="
    --e2f-bg: {{ section.settings.background }};
    --e2f-card: {{ section.settings.card_background }};
    --e2f-text: {{ section.settings.text_color }};
    --e2f-muted: {{ section.settings.muted_color }};
    --e2f-accent: {{ section.settings.accent_color }};
  "
>
  <div class="e2f-reviews__inner">

    <div class="e2f-reviews__top">
      <div class="e2f-reviews__titles">

        {% if section.settings.eyebrow != blank %}
          <div class="e2f-reviews__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h2 class="e2f-reviews__heading">
          <span>{{ section.settings.heading }}</span>

          {% if section.settings.heading_accent != blank %}
            <em>{{ section.settings.heading_accent }}</em>
          {% endif %}
        </h2>

      </div>

      {% if section.blocks.size > 1 %}
        <div class="e2f-reviews__arrows">
          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-prev="{{ section.id }}"
            aria-label="Avis précédent"
          >
            ←
          </button>

          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-next="{{ section.id }}"
            aria-label="Avis suivant"
          >
            →
          </button>
        </div>
      {% endif %}
    </div>


    <div class="e2f-reviews__content">

      <!-- NOTE GLOBALE -->
      <aside class="e2f-score">

        {% if section.settings.score_label != blank %}
          <div class="e2f-score__label">
            {{ section.settings.score_label }}
          </div>
        {% endif %}

        <div class="e2f-score__number">
          {{ section.settings.rating }}
          <span>/5</span>
        </div>

        <div class="e2f-score__line"></div>

        <div
          class="e2f-stars"
          aria-label="{{ section.settings.rating }} sur 5"
        >
          ★★★★★
        </div>

        <p class="e2f-score__text">
          {{ section.settings.rating_text }}
        </p>

        {% if section.settings.review_count != blank %}
          <strong class="e2f-score__count">
            {{ section.settings.review_count }}
          </strong>
        {% endif %}

      </aside>


      <!-- SLIDER AVIS -->
      <div
        class="e2f-reviews__track"
        id="e2f-review-track-{{ section.id }}"
      >

        {% for block in section.blocks %}
          <article
            class="e2f-review-card"
            {{ block.shopify_attributes }}
          >

            <div class="e2f-review-card__media">

              {% if block.settings.video != blank %}

                {{
                  block.settings.video
                  | video_tag:
                    controls: true,
                    muted: true,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'e2f-review-card__video'
                }}

                <span class="e2f-review-card__badge">
                  ▶ VIDÉO
                </span>

              {% elsif block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    sizes: '(max-width: 749px) 78vw, 320px',
                    class: 'e2f-review-card__image'
                }}

                <span class="e2f-review-card__badge">
                  PHOTO CLIENT
                </span>

              {% else %}

                <div class="e2f-review-card__placeholder">
                  AJOUTE UNE PHOTO
                  <br>
                  OU UNE VIDÉO
                </div>

              {% endif %}

            </div>


            <div class="e2f-review-card__body">

              <div class="e2f-review-card__meta">
                <div class="e2f-review-card__stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.stars %}
                      ★
                    {% else %}
                      ☆
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.verified %}
                  <span class="e2f-review-card__verified">
                    ✓ Avis client
                  </span>
                {% endif %}
              </div>


              {% if block.settings.review != blank %}
                <div class="e2f-review-card__review">
                  {{ block.settings.review }}
                </div>
              {% endif %}


              <div class="e2f-review-card__footer">

                <div class="e2f-review-card__avatar">
                  {{ block.settings.name | slice: 0 | upcase }}
                </div>

                <div>
                  {% if block.settings.name != blank %}
                    <strong class="e2f-review-card__name">
                      {{ block.settings.name }}
                    </strong>
                  {% endif %}

                  {% if block.settings.product_name != blank %}
                    <div class="e2f-review-card__product">
                      A acheté : {{ block.settings.product_name }}
                    </div>
                  {% endif %}
                </div>

              </div>

            </div>

          </article>
        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>
  #e2f-reviews-{{ section.id }} {
    width: 100%;
    background: var(--e2f-bg);
    color: var(--e2f-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #e2f-reviews-{{ section.id }} * {
    box-sizing: border-box;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
    width: min(1500px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* HEADER */

  #e2f-reviews-{{ section.id }} .e2f-reviews__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 34px;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__eyebrow {
    margin-bottom: 8px;
    color: var(--e2f-accent);

    font-size: 12px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading {
    margin: 0;
    color: var(--e2f-text);

    font-family: var(--heading-font-family, inherit);
    font-size: clamp(34px, 4.2vw, 66px);
    line-height: 0.94;

    font-weight: 900;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading span,
  #e2f-reviews-{{ section.id }} .e2f-reviews__heading em {
    display: inline;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading em {
    margin-left: 8px;
    color: var(--e2f-accent);
    font-style: italic;
  }


  /* ARROWS */

  #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255,255,255,.22);
    background: transparent;
    color: var(--e2f-text);

    font-size: 20px;
    cursor: pointer;

    transition: .2s ease;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow:hover {
    background: var(--e2f-accent);
    color: #000;
    border-color: var(--e2f-accent);
  }


  /* MAIN LAYOUT */

  #e2f-reviews-{{ section.id }} .e2f-reviews__content {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
  }


  /* SCORE */

  #e2f-reviews-{{ section.id }} .e2f-score {
    position: relative;

    min-height: 520px;
    padding: 28px 25px;

    background: #080a0a;
    border: 1px solid rgba(255,255,255,.08);

    display: flex;
    flex-direction: column;
  }

  #e2f-reviews-{{ section.id }} .e2f-score::before {
    content: "";
    position: absolute;

    top: 0;
    right: 0;

    width: 40%;
    height: 150px;

    background: var(--e2f-accent);
    opacity: .07;

    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__label {
    position: relative;
    z-index: 1;

    display: inline-block;
    align-self: flex-start;

    padding: 6px 10px;

    background: var(--e2f-accent);
    color: #000;

    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number {
    margin-top: 18px;

    color: var(--e2f-accent);

    font-size: 72px;
    line-height: .92;
    font-weight: 950;
    letter-spacing: -5px;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number span {
    font-size: 22px;
    letter-spacing: -1px;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__line {
    width: 54px;
    height: 4px;

    margin: 20px 0 15px;

    background: var(--e2f-accent);
  }

  #e2f-reviews-{{ section.id }} .e2f-stars {
    color: #ffb000;
    font-size: 22px;
    letter-spacing: 2px;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__text {
    margin: 12px 0 0;

    color: #aaa;
    font-size: 12px;
    line-height: 1.45;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__count {
    margin-top: auto;
    padding-top: 30px;

    color: var(--e2f-text);
    font-size: 14px;
    line-height: 1.4;
  }


  /* TRACK */

  #e2f-reviews-{{ section.id }} .e2f-reviews__track {
    min-width: 0;

    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(285px, 330px);

    gap: 12px;

    overflow-x: auto;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__track::-webkit-scrollbar {
    display: none;
  }


  /* REVIEW CARD */

  #e2f-reviews-{{ section.id }} .e2f-review-card {
    min-width: 0;

    background: var(--e2f-card);
    color: #111;

    border: 1px solid rgba(255,255,255,.08);

    scroll-snap-align: start;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__media {
    position: relative;
    aspect-ratio: 4 / 5;

    background: #171717;
    overflow: hidden;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__image,
  #e2f-reviews-{{ section.id }} .e2f-review-card__video {
    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;

    padding: 6px 10px;

    background: var(--e2f-accent);
    color: #000;

    font-size: 10px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #777;

    font-size: 13px;
    line-height: 1.4;
    font-weight: 800;
    text-align: center;
  }


  /* REVIEW CONTENT */

  #e2f-reviews-{{ section.id }} .e2f-review-card__body {
    padding: 17px 16px 18px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    margin-bottom: 12px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__stars {
    color: #ffb000;

    font-size: 14px;
    line-height: 1;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__verified {
    padding: 5px 8px;

    background: rgba(0, 220, 190, .10);
    color: #008c78;

    font-size: 10px;
    line-height: 1;
    font-weight: 800;

    transform: skew(-8deg);
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review {
    min-height: 64px;

    color: #111;

    font-size: 14px;
    line-height: 1.45;
    font-weight: 650;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review p {
    margin: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__footer {
    margin-top: 18px;
    padding-top: 14px;

    border-top: 1px solid #e7e7e7;

    display: flex;
    align-items: center;
    gap: 10px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__avatar {
    width: 32px;
    height: 32px;

    flex: 0 0 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #0b0b0b;
    color: var(--e2f-accent);

    font-size: 12px;
    font-weight: 900;

    transform: skew(-8deg);
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__name {
    display: block;

    color: #111;
    font-size: 13px;
    line-height: 1.2;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__product {
    margin-top: 3px;

    color: #888;
    font-size: 10px;
    line-height: 1.3;
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #e2f-reviews-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
      width: calc(100% - 24px);
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__top {
      margin-bottom: 23px;
      align-items: flex-end;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading {
      font-size: clamp(31px, 10vw, 45px);
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading em {
      display: block;
      margin-left: 0;
      margin-top: 4px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
      display: none;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__content {
      display: block;
    }

    #e2f-reviews-{{ section.id }} .e2f-score {
      min-height: auto;

      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 18px;
      row-gap: 4px;

      margin-bottom: 14px;
      padding: 18px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__label {
      grid-column: 1 / -1;
      margin-bottom: 8px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__number {
      grid-row: 2 / 5;

      margin: 0;

      font-size: 52px;
      letter-spacing: -4px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__line {
      display: none;
    }

    #e2f-reviews-{{ section.id }} .e2f-stars {
      align-self: end;
      font-size: 16px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__text {
      margin: 0;
      font-size: 11px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__count {
      margin: 0;
      padding: 0;
      font-size: 11px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__track {
      width: calc(100vw - 12px);

      grid-auto-columns: 80vw;

      margin-right: -12px;
      padding-right: 24px;

      gap: 9px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__body {
      padding: 14px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__review {
      font-size: 13px;
    }

  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const track = document.getElementById('e2f-review-track-{{ section.id }}');
    const prev = document.querySelector('[data-e2f-prev="{{ section.id }}"]');
    const next = document.querySelector('[data-e2f-next="{{ section.id }}"]');

    if (!track) return;

    function getScrollAmount() {
      const card = track.querySelector('.e2f-review-card');

      if (!card) return 340;

      return card.getBoundingClientRect().width + 12;
    }

    if (prev) {
      prev.addEventListener('click', function () {
        track.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });
      });
    }

    if (next) {
      next.addEventListener('click', function () {
        track.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });
      });
    }
  });
</script>


{% schema %}
