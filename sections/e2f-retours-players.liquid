<section
  id="e2f-reviews-{{ section.id }}"
  class="e2f-reviews"
  style="
    --e2f-bg: {{ section.settings.background }};
    --e2f-card: {{ section.settings.card_background }};
    --e2f-text: {{ section.settings.text_color }};
    --e2f-muted: {{ section.settings.muted_color }};
    --e2f-accent: {{ section.settings.accent_color }};
  "
>
  <div class="e2f-reviews__inner">

    <!-- HEADER -->
    <div class="e2f-reviews__top">

      <div class="e2f-reviews__titles">

        {% if section.settings.eyebrow != blank %}
          <div class="e2f-reviews__eyebrow">
            <span></span>
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h2 class="e2f-reviews__heading">
          {{ section.settings.heading }}

          {% if section.settings.heading_accent != blank %}
            <strong>{{ section.settings.heading_accent }}</strong>
          {% endif %}
        </h2>

        {% if section.settings.subtitle != blank %}
          <p class="e2f-reviews__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}

      </div>


      {% if section.blocks.size > 1 %}
        <div class="e2f-reviews__arrows">

          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-prev="{{ section.id }}"
            aria-label="Avis précédent"
          >
            ←
          </button>

          <button
            type="button"
            class="e2f-review-arrow"
            data-e2f-next="{{ section.id }}"
            aria-label="Avis suivant"
          >
            →
          </button>

        </div>
      {% endif %}

    </div>


    <!-- CONTENT -->
    <div class="e2f-reviews__content">

      <!-- SCORE -->
      <aside class="e2f-score">

        <div class="e2f-score__accent"></div>

        {% if section.settings.score_label != blank %}
          <div class="e2f-score__label">
            {{ section.settings.score_label }}
          </div>
        {% endif %}

        <div class="e2f-score__number">
          {{ section.settings.rating }}
          <span>/5</span>
        </div>

        <div class="e2f-score__stars">
          ★★★★★
        </div>

        <p class="e2f-score__text">
          {{ section.settings.rating_text }}
        </p>

        {% if section.settings.review_count != blank %}
          <div class="e2f-score__count">
            {{ section.settings.review_count }}
          </div>
        {% endif %}

        <div class="e2f-score__brand">
          ESPRIT2'FOOT
          <span>T'ES EN ESPRIT.</span>
        </div>

      </aside>


      <!-- REVIEWS -->
      <div
        class="e2f-reviews__track"
        id="e2f-review-track-{{ section.id }}"
      >

        {% for block in section.blocks %}

          <article
            class="e2f-review-card"
            {{ block.shopify_attributes }}
          >

            <div class="e2f-review-card__media">

              <div class="e2f-review-card__index">
                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
              </div>

              {% if block.settings.video != blank %}

                {{
                  block.settings.video
                  | video_tag:
                    controls: true,
                    muted: true,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'e2f-review-card__video'
                }}

                <span class="e2f-review-card__badge">
                  VIDÉO PLAYER
                </span>

              {% elsif block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900',
                    sizes: '(max-width: 749px) 82vw, 330px',
                    class: 'e2f-review-card__image'
                }}

                <span class="e2f-review-card__badge">
                  PHOTO PLAYER
                </span>

              {% else %}

                <div class="e2f-review-card__placeholder">
                  <strong>TON MÉDIA ICI</strong>
                  <span>Photo ou vidéo client</span>
                </div>

              {% endif %}

            </div>


            <div class="e2f-review-card__body">

              <div class="e2f-review-card__meta">

                <div class="e2f-review-card__stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.stars %}
                      ★
                    {% else %}
                      ☆
                    {% endif %}
                  {% endfor %}
                </div>

                {% if block.settings.verified %}
                  <span class="e2f-review-card__verified">
                    ✓ ACHAT VÉRIFIÉ
                  </span>
                {% endif %}

              </div>


              {% if block.settings.review != blank %}
                <div class="e2f-review-card__review">
                  {{ block.settings.review }}
                </div>
              {% endif %}


              <div class="e2f-review-card__footer">

                <div class="e2f-review-card__avatar">
                  {{ block.settings.name | slice: 0, 1 | upcase }}
                </div>

                <div class="e2f-review-card__identity">

                  {% if block.settings.name != blank %}
                    <strong class="e2f-review-card__name">
                      {{ block.settings.name }}
                    </strong>
                  {% endif %}

                  {% if block.settings.product_name != blank %}
                    <span class="e2f-review-card__product">
                      {{ block.settings.product_name }}
                    </span>
                  {% endif %}

                </div>

              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>
  #e2f-reviews-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--e2f-bg);
    color: var(--e2f-text);
  }

  #e2f-reviews-{{ section.id }} * {
    box-sizing: border-box;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
    width: min(1500px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* HEADER */

  #e2f-reviews-{{ section.id }} .e2f-reviews__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 32px;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;

    margin-bottom: 11px;

    color: var(--e2f-accent);

    font-size: 11px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__eyebrow span {
    display: block;

    width: 24px;
    height: 2px;

    background: var(--e2f-accent);
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading {
    max-width: 1000px;

    margin: 0;

    color: var(--e2f-text);

    font-family:
      var(--text-font-family),
      Arial,
      Helvetica,
      sans-serif;

    font-size: clamp(33px, 4vw, 62px);
    line-height: .98;

    font-weight: 850;
    letter-spacing: -.045em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading strong {
    position: relative;

    display: inline-block;

    margin-left: 8px;

    color: var(--e2f-accent);

    font-weight: 850;
    font-style: normal;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__heading strong::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -5px;

    width: 38%;
    height: 3px;

    background: var(--e2f-accent);
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__subtitle {
    max-width: 600px;

    margin: 17px 0 0;

    color: var(--e2f-muted);

    font-size: 13px;
    line-height: 1.5;
  }


  /* NAV */

  #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
    display: flex;
    gap: 7px;
    flex-shrink: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid rgba(255,255,255,.18);
    border-radius: 0;

    background: transparent;
    color: var(--e2f-text);

    font-size: 18px;

    cursor: pointer;

    transition:
      background .2s ease,
      color .2s ease,
      border-color .2s ease;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-arrow:hover {
    background: var(--e2f-accent);
    border-color: var(--e2f-accent);
    color: #050505;
  }


  /* LAYOUT */

  #e2f-reviews-{{ section.id }} .e2f-reviews__content {
    display: grid;

    grid-template-columns: 215px minmax(0, 1fr);

    gap: 16px;
    align-items: stretch;
  }


  /* SCORE */

  #e2f-reviews-{{ section.id }} .e2f-score {
    position: relative;

    min-height: 500px;

    padding: 26px 22px;

    display: flex;
    flex-direction: column;

    background: #080909;

    border-top: 1px solid rgba(255,255,255,.15);
    border-right: 1px solid rgba(255,255,255,.10);
    border-bottom: 1px solid rgba(255,255,255,.10);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__accent {
    position: absolute;

    top: 0;
    left: 0;

    width: 4px;
    height: 105px;

    background: var(--e2f-accent);
  }

  #e2f-reviews-{{ section.id }} .e2f-score__label {
    margin-bottom: 18px;

    color: var(--e2f-accent);

    font-size: 10px;
    line-height: 1;

    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number {
    color: #fff;

    font-size: clamp(58px, 5vw, 76px);
    line-height: .88;

    font-weight: 850;
    letter-spacing: -.07em;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__number span {
    margin-left: 3px;

    color: var(--e2f-accent);

    font-size: 20px;
    letter-spacing: -.03em;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__stars {
    margin-top: 24px;

    color: #ffb000;

    font-size: 18px;
    letter-spacing: 2px;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__text {
    margin: 13px 0 0;

    color: #949494;

    font-size: 11px;
    line-height: 1.5;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__count {
    margin-top: 8px;

    color: #fff;

    font-size: 13px;
    font-weight: 750;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__brand {
    margin-top: auto;
    padding-top: 30px;

    border-top: 1px solid rgba(255,255,255,.10);

    color: #fff;

    font-size: 10px;
    line-height: 1.3;

    font-weight: 850;
    letter-spacing: .08em;
  }

  #e2f-reviews-{{ section.id }} .e2f-score__brand span {
    display: block;

    margin-top: 5px;

    color: var(--e2f-accent);

    font-size: 9px;
  }


  /* TRACK */

  #e2f-reviews-{{ section.id }} .e2f-reviews__track {
    min-width: 0;

    display: grid;

    grid-auto-flow: column;
    grid-auto-columns: minmax(285px, 330px);

    gap: 11px;

    overflow-x: auto;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  #e2f-reviews-{{ section.id }} .e2f-reviews__track::-webkit-scrollbar {
    display: none;
  }


  /* CARDS */

  #e2f-reviews-{{ section.id }} .e2f-review-card {
    position: relative;

    min-width: 0;

    background: var(--e2f-card);
    color: #111;

    border: 1px solid rgba(255,255,255,.12);

    scroll-snap-align: start;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__media {
    position: relative;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: #181818;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__image,
  #e2f-reviews-{{ section.id }} .e2f-review-card__video {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__index {
    position: absolute;
    z-index: 3;

    top: 11px;
    right: 12px;

    color: rgba(255,255,255,.82);

    font-size: 11px;
    line-height: 1;

    font-weight: 800;
    letter-spacing: .12em;

    text-shadow: 0 1px 4px rgba(0,0,0,.45);
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__badge {
    position: absolute;
    z-index: 3;

    left: 0;
    bottom: 0;

    padding: 7px 10px;

    background: var(--e2f-accent);
    color: #050505;

    font-size: 9px;
    line-height: 1;

    font-weight: 900;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 5px;

    color: #717171;

    text-align: center;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder strong {
    color: #969696;

    font-size: 12px;
    letter-spacing: .07em;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__placeholder span {
    font-size: 10px;
  }


  /* CARD BODY */

  #e2f-reviews-{{ section.id }} .e2f-review-card__body {
    padding: 17px 15px 18px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 12px;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__stars {
    color: #ffab00;

    font-size: 13px;
    line-height: 1;

    letter-spacing: 1px;
    white-space: nowrap;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__verified {
    color: #007f70;

    font-size: 9px;
    line-height: 1;

    font-weight: 850;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review {
    min-height: 65px;

    color: #101010;

    font-size: 14px;
    line-height: 1.45;

    font-weight: 650;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__review p {
    margin: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__footer {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-top: 18px;
    padding-top: 13px;

    border-top: 1px solid #e3e3e3;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__avatar {
    width: 30px;
    height: 30px;

    flex: 0 0 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #0b0b0b;
    color: var(--e2f-accent);

    font-size: 11px;
    font-weight: 900;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__identity {
    min-width: 0;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__name {
    display: block;

    color: #111;

    font-size: 12px;
    line-height: 1.2;
  }

  #e2f-reviews-{{ section.id }} .e2f-review-card__product {
    display: block;

    margin-top: 3px;

    color: #919191;

    font-size: 9px;
    line-height: 1.3;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #e2f-reviews-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__inner {
      width: calc(100% - 24px);
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__top {
      margin-bottom: 24px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading {
      font-size: clamp(31px, 9vw, 43px);
      line-height: 1;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__heading strong {
      display: block;

      width: fit-content;

      margin: 4px 0 0;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__subtitle {
      margin-top: 14px;

      font-size: 12px;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__arrows {
      display: none;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__content {
      display: block;
    }

    #e2f-reviews-{{ section.id }} .e2f-score {
      min-height: auto;

      display: grid;

      grid-template-columns: auto 1fr;
      column-gap: 17px;
      row-gap: 4px;

      margin-bottom: 13px;
      padding: 18px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__accent {
      height: 100%;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__label {
      grid-column: 1 / -1;

      margin-bottom: 8px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__number {
      grid-row: 2 / 5;

      font-size: 51px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__stars {
      align-self: end;

      margin: 0;

      font-size: 15px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__text {
      margin: 0;

      font-size: 10px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__count {
      margin: 0;

      font-size: 11px;
    }

    #e2f-reviews-{{ section.id }} .e2f-score__brand {
      display: none;
    }

    #e2f-reviews-{{ section.id }} .e2f-reviews__track {
      width: calc(100vw - 12px);

      margin-right: -12px;
      padding-right: 24px;

      grid-auto-columns: 81vw;

      gap: 9px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__body {
      padding: 14px;
    }

    #e2f-reviews-{{ section.id }} .e2f-review-card__review {
      font-size: 13px;
    }

  }
</style>


<script>
  (function () {
    function initE2FReviews() {
      var track = document.getElementById('e2f-review-track-{{ section.id }}');
      var prev = document.querySelector('[data-e2f-prev="{{ section.id }}"]');
      var next = document.querySelector('[data-e2f-next="{{ section.id }}"]');

      if (!track) return;

      function scrollAmount() {
        var card = track.querySelector('.e2f-review-card');

        if (!card) return 340;

        return card.getBoundingClientRect().width + 11;
      }

      if (prev && !prev.dataset.e2fReady) {
        prev.dataset.e2fReady = 'true';

        prev.addEventListener('click', function () {
          track.scrollBy({
            left: -scrollAmount(),
            behavior: 'smooth'
          });
        });
      }

      if (next && !next.dataset.e2fReady) {
        next.dataset.e2fReady = 'true';

        next.addEventListener('click', function () {
          track.scrollBy({
            left: scrollAmount(),
            behavior: 'smooth'
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initE2FReviews);
    } else {
      initE2FReviews();
    }

    document.addEventListener('shopify:section:load', initE2FReviews);
  })();
</script>


{% schema %}
{
  "name": "E2F - Retours Players V2",
  "tag": "section",
  "class": "shopify-section--e2f-reviews",

  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "LA COMMUNAUTÉ E2F"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "LES RETOURS DE"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Partie turquoise",
      "default": "NOS PLAYERS."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Photos, vidéos et avis envoyés par nos clients après réception de leur commande."
    },

    {
      "type": "header",
      "content": "Note globale"
    },
    {
      "type": "text",
      "id": "score_label",
      "label": "Label",
      "default": "NOTE DES PLAYERS"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Note",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Texte sous la note",
      "default": "Basé sur les avis de nos Players."
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Nombre d'avis",
      "default": "+300 avis clients"
    },

    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fond",
      "default": "#080909"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond des avis",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texte secondaire",
      "default": "#898989"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur Esprit2'FOOT",
      "default": "#00E6E6"
    },

    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Haut ordinateur",
      "min": 20,
