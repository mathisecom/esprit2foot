<section
  id="e2f-benefits-{{ section.id }}"
  class="e2f-benefits"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="e2f-benefits__container">

    {% if section.settings.heading != blank %}
      <div class="e2f-benefits__header">

        {% if section.settings.eyebrow != blank %}
          <p class="e2f-benefits__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        <h2 class="e2f-benefits__heading">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.subheading != blank %}
          <p class="e2f-benefits__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

      </div>
    {% endif %}

    <div class="e2f-benefits__grid">

      {% for block in section.blocks %}
        <div
          class="e2f-benefit-card"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="e2f-benefit-card__image-wrapper">
              <img
                src="{{ block.settings.image | image_url: width: 300 }}"
                alt="{{ block.settings.title | escape }}"
                class="e2f-benefit-card__image"
                loading="lazy"
                width="150"
                height="150"
              >
            </div>
          {% else %}
            <div class="e2f-benefit-card__icon">

              {% case block.settings.icon %}

                {% when 'light' %}
                  <span>🪶</span>

                {% when 'fit' %}
                  <span>🦶</span>

                {% when 'grip' %}
                  <span>⚡</span>

                {% when 'finish' %}
                  <span>💎</span>

                {% when 'resistance' %}
                  <span>🛡️</span>

              {% endcase %}

            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="e2f-benefit-card__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="e2f-benefit-card__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>


<style>

  #e2f-benefits-{{ section.id }} {
    width: 100%;
  }

  #e2f-benefits-{{ section.id }} * {
    box-sizing: border-box;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefits__container {
    max-width: 1400px;
    width: calc(100% - 40px);
    margin: 0 auto;
  }


  /* TITRE */

  #e2f-benefits-{{ section.id }} .e2f-benefits__header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 38px;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefits__eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    padding: 7px 14px;

    border-radius: 100px;

    background-color: {{ section.settings.accent_color }};

    color: #000000;

    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefits__heading {
    margin: 0;

    color: {{ section.settings.text_color }};

    font-size: 40px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -1px;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefits__subheading {
    margin: 14px auto 0;

    color: {{ section.settings.secondary_text_color }};

    font-size: 16px;
    line-height: 1.5;
  }


  /* GRILLE */

  #e2f-benefits-{{ section.id }} .e2f-benefits__grid {
    display: grid;

    grid-template-columns:
      repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));

    gap: 16px;
  }


  /* CARTES */

  #e2f-benefits-{{ section.id }} .e2f-benefit-card {
    position: relative;

    padding: 28px 20px;

    background-color: {{ section.settings.card_background }};

    border: 1px solid #e8e8e8;

    border-radius: {{ section.settings.card_radius }}px;

    text-align: center;

    overflow: hidden;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefit-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 50%;

    transform: translateX(-50%);

    width: 45px;
    height: 4px;

    background-color: {{ section.settings.accent_color }};

    border-radius: 0 0 10px 10px;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefit-card:hover {
    transform: translateY(-5px);

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
  }


  /* IMAGE */

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__image-wrapper {
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;

    margin: 0 auto 18px;

    border-radius: 50%;

    overflow: hidden;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* EMOJI PAR DÉFAUT */

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__icon {
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;

    margin: 0 auto 18px;

    border-radius: 50%;

    background-color: {{ section.settings.accent_color }};

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 30px;
  }


  /* TEXTE */

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__title {
    margin: 0 0 8px;

    color: {{ section.settings.text_color }};

    font-size: 18px;
    line-height: 1.25;
    font-weight: 800;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__text {
    max-width: 280px;

    margin: 0 auto;

    color: {{ section.settings.secondary_text_color }};

    font-size: 14px;
    line-height: 1.5;
  }

  #e2f-benefits-{{ section.id }} .e2f-benefit-card__text p {
    margin: 0;
  }


  /* TABLETTE */

  @media screen and (max-width: 990px) {

    #e2f-benefits-{{ section.id }} .e2f-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #e2f-benefits-{{ section.id }} .e2f-benefits__container {
      width: calc(100% - 24px);
    }

    #e2f-benefits-{{ section.id }} .e2f-benefits__header {
      margin-bottom: 24px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefits__heading {
      font-size: 28px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefits__subheading {
      font-size: 14px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefits__grid {
      gap: 10px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefit-card {
      padding: 22px 10px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefit-card__title {
      font-size: 14px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefit-card__text {
      font-size: 12px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefit-card__image-wrapper,
    #e2f-benefits-{{ section.id }} .e2f-benefit-card__icon {
      width: 60px;
      height: 60px;
    }

    #e2f-benefits-{{ section.id }} .e2f-benefit-card__icon {
      font-size: 25px;
    }

  }

</style>


{% schema %}
{
  "name": "E2F - Bénéfices produit",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "ESPRIT2'FOOT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Pourquoi les Players aiment ce modèle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Des crampons pensés pour associer confort, maintien et sensations sur le terrain."
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Taille des images",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Arrondi des cartes",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond de la section",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond des cartes",
      "default": "#F6F7F8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte principal",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "secondary_text_color",
      "label": "Texte secondaire",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur Esprit2'FOOT",
      "default": "#00E6E6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement haut",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement bas",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],

  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image personnalisée"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icône par défaut",
          "default": "light",
          "options": [
            {
              "value": "light",
              "label": "Légèreté"
            },
            {
              "value": "fit",
              "label": "Maintien"
            },
            {
              "value": "grip",
              "label": "Adhérence"
            },
            {
              "value": "finish",
              "label": "Finitions"
            },
            {
              "value": "resistance",
              "label": "Résistance"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Bénéfice produit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Une courte description du bénéfice.</p>"
        }
      ]
    }
  ],

  "max_blocks": 6,

  "presets": [
    {
      "name": "E2F - Bénéfices produit",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "light",
            "title": "Légèreté optimale",
            "text": "<p>Pensés pour conserver une grande liberté de mouvement sur le terrain.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "fit",
            "title": "Maintien du pied",
            "text": "<p>Une conception ajustée avec chausson intégré pour un maintien confortable.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "grip",
            "title": "Adhérence & réactivité",
            "text": "<p>Une semelle conçue pour offrir de bons appuis pendant le jeu.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "finish",
            "title": "Finitions soignées",
            "text": "<p>Des matériaux sélectionnés pour une paire propre, résistante et agréable à porter.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}