<script>
  (() => {
    const root = document.getElementById('e2fc-{{ sid }}');
    if (!root || root.dataset.e2fcReady === 'true') return;
    root.dataset.e2fcReady = 'true';

    const track = root.querySelector('.e2fc-track');
    const prev = root.querySelector('.e2fc-prev');
    const next = root.querySelector('.e2fc-next');

    if (!track) return;

    const distance = () => {
      const card = track.querySelector('.e2fc-card');
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    if (prev) {
      prev.addEventListener('click', () => {
        track.scrollBy({ left: -distance(), behavior: 'smooth' });
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        track.scrollBy({ left: distance(), behavior: 'smooth' });
      });
    }

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        track.scrollBy({ left: distance(), behavior: 'smooth' });
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        track.scrollBy({ left: -distance(), behavior: 'smooth' });
      }
    });
  })();
</script>

