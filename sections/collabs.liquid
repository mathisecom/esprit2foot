
{% liquid
  assign sid = section.id
%}

<section id="e2fc-{{ sid }}" class="e2fc">
  <div class="e2fc-shell">

    <header class="e2fc-header">
      {% if section.settings.logo != blank %}
        <img
          class="e2fc-brand-logo"
          src="{{ section.settings.logo | image_url: width: 500 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="lazy"
        >
      {% endif %}

      <h2 class="e2fc-title">
        <span>{{ section.settings.title_black | escape }}</span>
        <span class="e2fc-title-accent">{{ section.settings.title_accent | escape }}</span>
      </h2>

      {% if section.settings.subtitle != blank %}
        <p class="e2fc-subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      <div class="e2fc-controls">
        <button class="e2fc-arrow e2fc-prev" type="button" aria-label="Créateur précédent">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
        </button>
        <button class="e2fc-arrow e2fc-next" type="button" aria-label="Créateur suivant">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
    </header>

    <div class="e2fc-main">

      <aside class="e2fc-feature">
        <div class="e2fc-corner e2fc-corner-top" aria-hidden="true"></div>

        <div class="e2fc-feature-heading">
          <span class="e2fc-feature-line"></span>
          <h3>{{ section.settings.feature_title | escape }}</h3>
        </div>

        {% if section.settings.feature_number != blank %}
          <div class="e2fc-feature-number">
            <span>{{ section.settings.feature_number | escape }}</span><b>+</b>
          </div>
        {% endif %}

        {% if section.settings.feature_number_label != blank %}
          <p class="e2fc-feature-number-label">
            {{ section.settings.feature_number_label | escape }}
          </p>
        {% endif %}

        <div class="e2fc-feature-divider"></div>

        <div class="e2fc-feature-description">
          <svg viewBox="0 0 64 48" aria-hidden="true">
            <path d="M23 28 14 37 3 26l12-16 11-5 8 2 6 8 7-4 9 3 5 11-15 17-8 2-6-5-5-1-4-5Z"/>
            <path d="m15 10 12 11 9-5 8 6 6-5M23 28l7 7m-2-12 8 8m-3-15 6 6m-10 13 5 5m7-9 6 6"/>
          </svg>
          <p>{{ section.settings.feature_description | escape }}</p>
        </div>

        <div class="e2fc-feature-divider"></div>

        <div class="e2fc-feature-brand">
          {% if section.settings.feature_logo != blank %}
            <img
              src="{{ section.settings.feature_logo | image_url: width: 400 }}"
              alt="{{ shop.name | escape }}"
              width="{{ section.settings.feature_logo.width }}"
              height="{{ section.settings.feature_logo.height }}"
              loading="lazy"
            >
          {% else %}
            <span class="e2fc-brand-monogram">EF</span>
            <span class="e2fc-brand-name">ESPRIT<span>2’FOOT</span></span>
          {% endif %}
        </div>

        <div class="e2fc-corner e2fc-corner-bottom" aria-hidden="true"></div>
      </aside>

      <div class="e2fc-carousel">
        <div class="e2fc-track" tabindex="0" aria-label="Carrousel des créateurs">
          {% for block in section.blocks %}
            {% if block.type == 'creator' %}
              <article class="e2fc-card" {{ block.shopify_attributes }}>

                <a
                  class="e2fc-media"
                  {% if block.settings.video_url != blank %}
                    href="{{ block.settings.video_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Voir la vidéo de {{ block.settings.name | escape }}"
                  {% else %}
                    href="#"
                    aria-label="{{ block.settings.name | escape }}"
                    onclick="return false;"
                  {% endif %}
                >
                  {% if block.settings.cover != blank %}
                    <img
                      src="{{ block.settings.cover | image_url: width: 900 }}"
                      alt="{{ block.settings.cover.alt | default: block.settings.name | escape }}"
                      width="{{ block.settings.cover.width }}"
                      height="{{ block.settings.cover.height }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="e2fc-media-placeholder">
                      <span class="e2fc-placeholder-play">▶</span>
                      <span>Ajoutez une photo</span>
                    </div>
                  {% endif %}

                  <span class="e2fc-social-pill">
                    {% if block.settings.platform == 'TikTok' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M16 3c.4 2.4 1.8 3.8 4 4v3.5a9 9 0 0 1-4-1.2v6.4a6.3 6.3 0 1 1-6.3-6.3c.5 0 1 0 1.4.2v3.8a2.7 2.7 0 1 0 1.3 2.3V3H16Z"/>
                      </svg>
                    {% elsif block.settings.platform == 'Instagram' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="5"/>
                        <circle cx="12" cy="12" r="4"/>
                        <circle cx="17.5" cy="6.5" r="1" class="e2fc-icon-fill"/>
                      </svg>
                    {% elsif block.settings.platform == 'YouTube' %}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="2" y="5" width="20" height="14" rx="4"/>
                        <path d="m10 9 5 3-5 3Z" class="e2fc-icon-fill"/>
                      </svg>
                    {% else %}
                      <span class="e2fc-other-icon">↗</span>
                    {% endif %}
                    <span>{{ block.settings.platform | escape }}</span>
                  </span>

                  <span class="e2fc-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 5 11 7-11 7Z"/></svg>
                  </span>
                </a>

                <div class="e2fc-card-content">
                  <div class="e2fc-profile">
                    {% if block.settings.avatar != blank %}
                      <img
                        class="e2fc-avatar"
                        src="{{ block.settings.avatar | image_url: width: 120 }}"
                        alt=""
                        width="{{ block.settings.avatar.width }}"
                        height="{{ block.settings.avatar.height }}"
                        loading="lazy"
                      >
                    {% else %}
                      <div class="e2fc-avatar e2fc-avatar-placeholder" aria-hidden="true">
                        {{ block.settings.name | slice: 0 | upcase }}
                      </div>
                    {% endif %}

                    <div class="e2fc-person">
                      <div class="e2fc-name-line">
                        <strong>{{ block.settings.name | escape }}</strong>
                        {% if block.settings.verified %}
                          <span class="e2fc-verified" aria-label="Compte vérifié">✓</span>
                        {% endif %}
                      </div>
                      {% if block.settings.handle != blank %}
                        <span class="e2fc-handle">{{ block.settings.handle | escape }}</span>
                      {% endif %}
                    </div>
                  </div>

                  {% if block.settings.description != blank %}
                    <p class="e2fc-description">{{ block.settings.description | escape }}</p>
                  {% endif %}

                  {% if block.settings.video_url != blank %}
                    <a
                      class="e2fc-button"
                      href="{{ block.settings.video_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7Z"/></svg>
                      <span>{{ block.settings.button_label | default: 'Voir la vidéo' | escape }}</span>
                      <span class="e2fc-button-external" aria-hidden="true">↗</span>
                    </a>
                  {% else %}
                    <span class="e2fc-button e2fc-button-disabled">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 12 7-12 7Z"/></svg>
                      <span>{{ block.settings.button_label | default: 'Voir la vidéo' | escape }}</span>
                      <span class="e2fc-button-external" aria-hidden="true">↗</span>
                    </span>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="e2fc-stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div class="e2fc-stat" {{ block.shopify_attributes }}>
            {% case block.settings.icon %}
              {% when 'people' %}
                <svg class="e2fc-stat-icon" viewBox="0 0 48 48" aria-hidden="true">
                  <circle cx="24" cy="14" r="8"/>
                  <path d="M8 39v-5a16 16 0 0 1 32 0v5Z"/>
                  <path d="M10 16a6 6 0 0 0 0 12m28-12a6 6 0 0 1 0 12M4 39v-4a10 10 0 0 1 5-9m35 13v-4a10 10 0 0 0-5-9"/>
                </svg>
              {% when 'video' %}
                <svg class="e2fc-stat-icon" viewBox="0 0 48 48" aria-hidden="true">
                  <circle cx="24" cy="24" r="19"/>
                  <path d="m20 15 14 9-14 9Z"/>
                </svg>
              {% when 'handshake' %}
                <svg class="e2fc-stat-icon" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="m3 17 9-8 10 4 6-2 7 5 10-3 2 7-14 17-7-4-5-5-5 1-13-12Z"/>
                  <path d="m12 9 10 11 7-4 7 5M17 28l5 5m0-9 7 7m0-11 7 6"/>
                </svg>
              {% else %}
                <svg class="e2fc-stat-icon" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M27 3 9 27h12l-2 18 20-27H26Z"/>
                </svg>
            {% endcase %}

            <strong>{{ block.settings.value | escape }}</strong>
            <span>{{ block.settings.label | escape }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #e2fc-{{ sid }} {
    --e2fc-turquoise: {{ section.settings.accent }};
    --e2fc-ink: {{ section.settings.text_color }};
    --e2fc-muted: {{ section.settings.muted_color }};
    --e2fc-border: #e8e8e8;
    background: {{ section.settings.background }};
    color: var(--e2fc-ink);
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #e2fc-{{ sid }} *,
  #e2fc-{{ sid }} *::before,
  #e2fc-{{ sid }} *::after {
    box-sizing: border-box;
  }

  #e2fc-{{ sid }} .e2fc-shell {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #e2fc-{{ sid }} .e2fc-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #e2fc-{{ sid }} .e2fc-brand-logo {
    display: block;
    width: min({{ section.settings.logo_width }}px, 75%);
    height: auto;
    max-height: 100px;
    object-fit: contain;
    margin: 0 auto 26px;
  }

  #e2fc-{{ sid }} .e2fc-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 14px;
    margin: 0;
    font-size: clamp(32px, 5.5vw, {{ section.settings.heading_size }}px);
    line-height: 1.06;
    letter-spacing: -.055em;
    font-weight: 950;
    text-transform: uppercase;
    font-style: italic;
  }

  #e2fc-{{ sid }} .e2fc-title-accent {
    position: relative;
    color: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-title-accent::after {
    content: "";
    position: absolute;
    bottom: -9px;
    left: 35%;
    width: 30%;
    height: 5px;
    border-radius: 99px;
    background: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-subtitle {
    max-width: 760px;
    margin: 24px auto 28px;
    color: var(--e2fc-ink);
    font-size: clamp(15px, 2.2vw, 22px);
    line-height: 1.45;
    font-weight: 400;
  }

  #e2fc-{{ sid }} .e2fc-controls {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin: 0 0 30px;
  }

  #e2fc-{{ sid }} .e2fc-arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 14px;
    border: 2px solid var(--e2fc-border);
    border-radius: 50%;
    background: #fff;
    color: #080808;
    cursor: pointer;
    transition: background .2s, border-color .2s, transform .2s;
  }

  #e2fc-{{ sid }} .e2fc-arrow svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #e2fc-{{ sid }} .e2fc-arrow.e2fc-next {
    border-color: var(--e2fc-turquoise);
    background: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-arrow:hover {
    transform: translateY(-2px);
    border-color: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-main {
    display: grid;
    grid-template-columns: minmax(280px, .92fr) minmax(0, 1fr);
    gap: 22px;
    align-items: stretch;
  }

  #e2fc-{{ sid }} .e2fc-feature {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-width: 0;
    min-height: 480px;
    padding: clamp(26px, 3.6vw, 44px);
    overflow: hidden;
    border-radius: 28px;
    background: #020707;
    color: #fff;
    isolation: isolate;
  }

  #e2fc-{{ sid }} .e2fc-feature::before {
    position: absolute;
    z-index: -1;
    right: -80px;
    top: -70px;
    width: 220px;
    height: 220px;
    border: 1px solid rgba(0, 229, 220, .14);
    border-radius: 50%;
    content: "";
  }

  #e2fc-{{ sid }} .e2fc-corner {
    position: absolute;
    z-index: -1;
    width: 100px;
    height: 16px;
    background: var(--e2fc-turquoise);
    transform: rotate(-48deg);
  }

  #e2fc-{{ sid }} .e2fc-corner::after {
    position: absolute;
    top: 0;
    left: 25px;
    width: 100%;
    height: 100%;
    background: var(--e2fc-turquoise);
    content: "";
  }

  #e2fc-{{ sid }} .e2fc-corner-top {
    top: 22px;
    right: -22px;
  }

  #e2fc-{{ sid }} .e2fc-corner-bottom {
    bottom: 23px;
    left: -25px;
  }

  #e2fc-{{ sid }} .e2fc-feature-heading {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 26px;
  }

  #e2fc-{{ sid }} .e2fc-feature-line {
    flex: 0 0 4px;
    min-height: 68px;
    border-radius: 5px;
    background: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-feature-heading h3 {
    max-width: 300px;
    margin: 0;
    color: var(--e2fc-turquoise);
    font-size: clamp(25px, 3.1vw, 39px);
    font-weight: 950;
    font-style: italic;
    line-height: 1.12;
    letter-spacing: -.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #e2fc-{{ sid }} .e2fc-feature-number {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 3px;
    margin: 0;
    font-size: clamp(55px, 7vw, 94px);
    font-weight: 950;
    line-height: .98;
    letter-spacing: -.06em;
    white-space: nowrap;
  }

  #e2fc-{{ sid }} .e2fc-feature-number b {
    color: var(--e2fc-turquoise);
    font-weight: 950;
  }

  #e2fc-{{ sid }} .e2fc-feature-number-label {
    margin: 8px 0 22px;
    color: #fff;
    font-size: clamp(15px, 1.8vw, 21px);
    text-align: center;
  }

  #e2fc-{{ sid }} .e2fc-feature-divider {
    width: 100%;
    height: 1px;
    flex-shrink: 0;
    background: rgba(255,255,255,.75);
  }

  #e2fc-{{ sid }} .e2fc-feature-description {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    padding: 24px 0;
  }

  #e2fc-{{ sid }} .e2fc-feature-description svg {
    width: 100%;
    height: auto;
    fill: none;
    stroke: var(--e2fc-turquoise);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #e2fc-{{ sid }} .e2fc-feature-description p {
    margin: 0;
    color: #fff;
    font-size: clamp(14px, 1.7vw, 20px);
    line-height: 1.42;
  }

  #e2fc-{{ sid }} .e2fc-feature-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 22px;
  }

  #e2fc-{{ sid }} .e2fc-feature-brand img {
    display: block;
    width: min(100%, 260px);
    max-height: 66px;
    object-fit: contain;
  }

  #e2fc-{{ sid }} .e2fc-brand-monogram {
    color: #fff;
    font-size: 38px;
    font-weight: 950;
    font-style: italic;
  }

  #e2fc-{{ sid }} .e2fc-brand-name {
    color: #fff;
    font-size: clamp(13px, 1.6vw, 21px);
    font-weight: 950;
    font-style: italic;
    white-space: nowrap;
  }

  #e2fc-{{ sid }} .e2fc-brand-name span {
    color: var(--e2fc-turquoise);
  }

  #e2fc-{{ sid }} .e2fc-carousel {
    min-width: 0;
    overflow: hidden;
  }

  #e2fc-{{ sid }} .e2fc-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, calc(50% - 8px));
    align-items: stretch;
    gap: 16px;
    height: 100%;
    padding: 2px 2px 12px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #e2fc-{{ sid }} .e2fc-track::-webkit-scrollbar {
    display: none;
  }

  #e2fc-{{ sid }} .e2fc-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e9e9e9;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 7px 16px rgba(0,0,0,.11);
    scroll-snap-align: start;
  }

  #e2fc-{{ sid }} .e2fc-media {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 100%;
    aspect-ratio: {{ section.settings.media_ratio }};
    overflow: hidden;
    background: #e8ebed;
    color: #080808;
    text-decoration: none;
  }

  #e2fc-{{ sid }} .e2fc-media > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  #e2fc-{{ sid }} .e2fc-media:hover > img {
    transform: scale(1.035);
  }

  #e2fc-{{ sid }} .e2fc-media-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    color: #444;
    font-size: 12px;
  }

  #e2fc-{{ sid }} .e2fc-placeholder-play {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--e2fc-turquoise);
    color: #050505;
    font-size: 22px;
  }

  #e2fc-{{ sid }} .e2fc-social-pill {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 32px);
    padding: 8px 13px;
    border-radius: 50px;
    background: #050505;
    color: #fff;
    font-size: 14px;
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
  }

  #e2fc-{{ sid }} .e2fc-social-pill svg {
    width: 25px;
    height: 25px;
    flex-shrink: 0;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  #e2fc-{{ sid }} .e2fc-social-pill svg rect,
  #e2fc-{{ sid }} .e2fc-social-pill svg circle {
    fill: none;
  }

  #e2fc-{{ sid }} .e2fc-social-pill svg .e2fc-icon-fill {
    fill: currentColor;
  }

  #e2fc-{{ sid }} .e2fc-other-icon {
    font-size: 23px;
    font-style: normal;
  }

  #e2fc-{{ sid }} .e2fc-play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    padding: 18px;
    border: 3px solid #fff;
    border-radius: 50%;
    background: rgba(0,0,0,.48);
    color: #fff;
    transform: translate(-50%, -50%);
    transition: background .2s, transform .2s;
  }

  #e2fc-{{ sid }} .e2fc-play svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #e2fc-{{ sid }} .e2fc-media:hover .e2fc-play {
    background: var(--e2fc-turquoise);
    color: #050505;
    transform: translate(-50%, -50%) scale(1.06);
  }

  #e2fc-{{ sid }} .e2fc-card-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 16px;
    padding: 17px;
  }

  #e2fc-{{ sid }} .e2fc-profile {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  #e2fc-{{ sid }} .e2fc-avatar {
    display: block;
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
    border: 1px solid #eee;
    border-radius: 50%;
    object-fit: cover;
    background: #f0f0f0;
  }

  #e2fc-{{ sid }} .e2fc-avatar-placeholder {
    display: grid;
    place-items: center;
    color: #111;
    font-size: 18px;
    font-weight: 900;
  }

  #e2fc-{{ sid }} .e2fc-person {
    flex: 1 1 auto;
    min-width: 0;
  }

  #e2fc-{{ sid }} .e2fc-name-line {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  #e2fc-{{ sid }} .e2fc-name-line strong {
    overflow: hidden;
    color: #080808;
    font-size: clamp(13px, 1.35vw, 17px);
    font-weight: 950;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #e2fc-{{ sid }} .e2fc-verified {
    display: grid;
    place-items: center;
    flex: 0 0 21px;
