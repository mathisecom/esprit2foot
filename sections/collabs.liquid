
{% comment %}
  Esprit2'FOOT — Nos collaborations
  Tous les textes, logos, couleurs, cartes et statistiques sont personnalisables.
{% endcomment %}

{% liquid
  assign section_title = section.settings.heading
  assign section_subtitle = section.settings.subtitle
%}

<section id="e2f-collabs-{{ section.id }}" class="e2f-collabs">
  <div class="e2f-wrap">

    {% if section.settings.show_header %}
      <header class="e2f-header">
        <div class="e2f-brand">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag: class: 'e2f-logo', alt: section.settings.logo_alt
            }}
          {% elsif section.settings.logo_text != blank %}
            <span class="e2f-logo-text">{{ section.settings.logo_text | escape }}</span>
          {% endif %}
        </div>

        {% if section_title != blank %}
          <h2 class="e2f-heading">{{ section_title | escape }}</h2>
        {% endif %}

        {% if section_subtitle != blank %}
          <div class="e2f-subtitle">{{ section_subtitle }}</div>
        {% endif %}

        <span class="e2f-line"></span>
      </header>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="e2f-intro">{{ section.settings.intro }}</div>
    {% endif %}

    <div class="e2f-grid">
      {% for block in section.blocks %}
        {% if block.type == 'collaboration' %}
          <article class="e2f-card" {{ block.shopify_attributes }}>

            <a
              class="e2f-media"
              href="{{ block.settings.video_url | default: '#' }}"
              {% if block.settings.video_url != blank %}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Voir la collaboration avec {{ block.settings.name | escape }}"
              {% endif %}
            >
              {% if block.settings.thumbnail != blank %}
                {{
                  block.settings.thumbnail
                  | image_url: width: 1000
                  | image_tag:
                    class: 'e2f-thumb',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}
              {% else %}
                <div class="e2f-placeholder">
                  <span>{{ block.settings.platform_icon | escape }}</span>
                  <small>Ajoute une miniature dans l’éditeur Shopify</small>
                </div>
              {% endif %}

              {% if block.settings.show_platform %}
                <span class="e2f-platform">
                  <span class="e2f-platform-icon">
                    {{ block.settings.platform_icon | escape }}
                  </span>
                  {{ block.settings.platform_label | escape }}
                </span>
              {% endif %}

              {% if block.settings.show_play %}
                <span class="e2f-play" aria-hidden="true">▶</span>
              {% endif %}

              {% if block.settings.badge != blank %}
                <span class="e2f-badge">{{ block.settings.badge | escape }}</span>
              {% endif %}
            </a>

            <div class="e2f-card-content">
              {% if block.settings.eyebrow != blank %}
                <p class="e2f-eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {% endif %}

              {% if block.settings.name != blank %}
                <h3>{{ block.settings.name | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="e2f-description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.show_bottom_icon %}
                <div class="e2f-card-icon">
                  <span>{{ block.settings.bottom_icon | escape }}</span>
                  {% if block.settings.bottom_text != blank %}
                    <span>{{ block.settings.bottom_text | escape }}</span>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.button_text != blank %}
                {% if block.settings.video_url != blank %}
                  <a
                    class="e2f-button"
                    href="{{ block.settings.video_url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {{ block.settings.button_text | escape }}
                    <span aria-hidden="true">↗</span>
                  </a>
                {% else %}
                  <span class="e2f-button e2f-button-disabled">
                    {{ block.settings.button_text | escape }}
                  </span>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% assign stats_exist = false %}
    {% for block in section.blocks %}
      {% if block.type == 'stat' %}
        {% assign stats_exist = true %}
      {% endif %}
    {% endfor %}

    {% if stats_exist %}
      <div class="e2f-stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="e2f-stat" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <span class="e2f-stat-icon">{{ block.settings.icon | escape }}</span>
              {% endif %}

              {% if block.settings.value != blank %}
                <strong>{{ block.settings.value | escape }}</strong>
              {% endif %}

              {% if block.settings.label != blank %}
                <span class="e2f-stat-label">{{ block.settings.label | escape }}</span>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.footer_text != blank %}
      <div class="e2f-footer">
        {{ section.settings.footer_text }}
      </div>
    {% endif %}

  </div>
</section>

<style>
  #e2f-collabs-{{ section.id }} {
    --e2f-turquoise: {{ section.settings.turquoise }};
    --e2f-ink: {{ section.settings.text_color }};
    --e2f-bg: {{ section.settings.background }};
    --e2f-card-bg: {{ section.settings.card_background }};
    --e2f-muted: {{ section.settings.muted_color }};
    --e2f-border: {{ section.settings.border_color }};
    --e2f-radius: {{ section.settings.radius }}px;
    --e2f-gap: {{ section.settings.gap }}px;
    background: var(--e2f-bg);
    color: var(--e2f-ink);
    padding: {{ section.settings.padding_top }}px 22px {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #e2f-collabs-{{ section.id }} *,
  #e2f-collabs-{{ section.id }} *::before,
  #e2f-collabs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #e2f-collabs-{{ section.id }} .e2f-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #e2f-collabs-{{ section.id }} .e2f-header {
    margin-bottom: 30px;
  }

  #e2f-collabs-{{ section.id }} .e2f-brand {
    margin-bottom: 26px;
  }

  #e2f-collabs-{{ section.id }} .e2f-logo {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  #e2f-collabs-{{ section.id }} .e2f-logo-text {
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.8px;
  }

  #e2f-collabs-{{ section.id }} .e2f-heading {
    margin: 0;
    color: var(--e2f-turquoise);
    font-size: clamp(30px, 5vw, {{ section.settings.heading_size }}px);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-transform: {{ section.settings.heading_case }};
  }

  #e2f-collabs-{{ section.id }} .e2f-subtitle {
    margin-top: 14px;
    color: var(--e2f-ink);
    font-size: 16px;
    line-height: 1.7;
    max-width: 720px;
  }

  #e2f-collabs-{{ section.id }} .e2f-line {
    display: block;
    width: {{ section.settings.line_width }}px;
    height: 5px;
    margin-top: 18px;
    background: var(--e2f-turquoise);
  }

  #e2f-collabs-{{ section.id }} .e2f-intro {
    margin: 0 0 28px;
    color: var(--e2f-muted);
    line-height: 1.7;
  }

  #e2f-collabs-{{ section.id }} .e2f-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--e2f-gap);
  }

  #e2f-collabs-{{ section.id }} .e2f-card {
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--e2f-card-bg);
    border: 1px solid var(--e2f-border);
    border-radius: var(--e2f-radius);
    box-shadow: {% if section.settings.card_shadow %}0 8px 26px rgba(0,0,0,.07){% else %}none{% endif %};
    transition: transform .22s ease, box-shadow .22s ease;
  }

  #e2f-collabs-{{ section.id }} .e2f-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0,0,0,.11);
  }

  #e2f-collabs-{{ section.id }} .e2f-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: {{ section.settings.media_ratio }};
    background: #f1f3f4;
    color: inherit;
    text-decoration: none;
  }

  #e2f-collabs-{{ section.id }} .e2f-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  #e2f-collabs-{{ section.id }} .e2f-card:hover .e2f-thumb {
    transform: scale(1.035);
  }

  #e2f-collabs-{{ section.id }} .e2f-placeholder {
    height: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: var(--e2f-ink);
    text-align: center;
  }

  #e2f-collabs-{{ section.id }} .e2f-placeholder > span {
    font-size: 38px;
  }

  #e2f-collabs-{{ section.id }} .e2f-placeholder small {
    font-size: 12px;
  }

  #e2f-collabs-{{ section.id }} .e2f-platform {
    position: absolute;
    top: 14px;
    left: 14px;
    max-width: calc(100% - 28px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    background: var(--e2f-ink);
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #e2f-collabs-{{ section.id }} .e2f-platform-icon {
    color: var(--e2f-turquoise);
    font-size: 16px;
  }

  #e2f-collabs-{{ section.id }} .e2f-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--e2f-turquoise);
    color: #000;
    font-size: 19px;
    box-shadow: 0 5px 20px rgba(0,0,0,.18);
    transition: transform .2s ease;
  }

  #e2f-collabs-{{ section.id }} .e2f-media:hover .e2f-play {
    transform: translate(-50%, -50%) scale(1.09);
  }

  #e2f-collabs-{{ section.id }} .e2f-badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: var(--e2f-turquoise);
    color: #000;
    padding: 7px 10px;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
  }

  #e2f-collabs-{{ section.id }} .e2f-card-content {
    padding: 21px;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
  }

  #e2f-collabs-{{ section.id }} .e2f-eyebrow {
    margin: 0 0 8px;
    color: var(--e2f-turquoise);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #e2f-collabs-{{ section.id }} .e2f-card-content h3 {
    margin: 0 0 10px;
    color: var(--e2f-ink);
    font-size: 21px;
    line-height: 1.25;
    font-weight: 900;
    overflow-wrap: anywhere;
  }

  #e2f-collabs-{{ section.id }} .e2f-description {
    margin-bottom: 18px;
    color: var(--e2f-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  #e2f-collabs-{{ section.id }} .e2f-description p {
    margin: 0 0 8px;
  }

  #e2f-collabs-{{ section.id }} .e2f-description p:last-child {
    margin-bottom: 0;
  }

  #e2f-collabs-{{ section.id }} .e2f-card-icon {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    margin-bottom: 18px;
    color: var(--e2f-turquoise);
    font-size: 12px;
    font-weight: 800;
  }

  #e2f-collabs-{{ section.id }} .e2f-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: auto;
    padding: 14px 17px;
    background: var(--e2f-turquoise);
    border: 1px solid var(--e2f-turquoise);
    border-radius: {{ section.settings.button_radius }}px;
    color: #000;
    text-align: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
    transition: background .2s ease, color .2s ease;
  }

  #e2f-collabs-{{ section.id }} a.e2f-button:hover {
    background: var(--e2f-ink);
    border-color: var(--e2f-ink);
    color: #fff;
  }

  #e2f-collabs-{{ section.id }} .e2f-button-disabled {
    opacity: .65;
    cursor: default;
  }

  #e2f-collabs-{{ section.id }} .e2f-stats {
    display: grid;
    grid-template-columns: repeat({{ section.settings.stats_columns }}, minmax(0, 1fr));
    margin-top: {{ section.settings.stats_margin }}px;
    background: var(--e2f-turquoise);
    border-radius: var(--e2f-radius);
    overflow: hidden;
  }

  #e2f-collabs-{{ section.id }} .e2f-stat {
    min-width: 0;
    padding: 25px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    color: {{ section.settings.stats_text_color }};
  }

  #e2f-collabs-{{ section.id }} .e2f-stat-icon {
    font-size: {{ section.settings.stats_icon_size }}px;
    line-height: 1.2;
  }

  #e2f-collabs-{{ section.id }} .e2f-stat strong {
    font-size: clamp(24px, 3vw, {{ section.settings.stats_value_size }}px);
    line-height: 1.05;
    font-weight: 950;
    overflow-wrap: anywhere;
  }

  #e2f-collabs-{{ section.id }} .e2f-stat-label {
    font-size: 13px;
    line-height: 1.4;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  #e2f-collabs-{{ section.id }} .e2f-footer {
    margin-top: 24px;
    color: var(--e2f-muted);
    text-align: center;
    font-size: 13px;
    line-height: 1.7;
  }

  @media screen and (max-width: 990px) {
    #e2f-collabs-{{ section.id }} .e2f-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #e2f-collabs-{{ section.id }} .e2f-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    #e2f-collabs-{{ section.id }} {
      padding-left: 15px;
      padding-right: 15px;
    }

    #e2f-collabs-{{ section.id }} .e2f-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }

    #e2f-collabs-{{ section.id }} .e2f-card-content {
      padding: 14px;
    }

    #e2f-collabs-{{ section.id }} .e2f-card-content h3 {
      font-size: 17px;
    }

    #e2f-collabs-{{ section.id }} .e2f-description {
      font-size: 13px;
    }

    #e2f-collabs-{{ section.id }} .e2f-platform {
      top: 8px;
      left: 8px;
      padding: 7px 8px;
      font-size: 9px;
      letter-spacing: .5px;
    }

    #e2f-collabs-{{ section.id }} .e2f-play {
      width: 43px;
      height: 43px;
      font-size: 15px;
    }

    #e2f-collabs-{{ section.id }} .e2f-button {
      padding: 12px 8px;
      font-size: 11px;
      gap: 6px;
    }

    #e2f-collabs-{{ section.id }} .e2f-stat {
      padding: 20px 8px;
    }

    #e2f-collabs-{{ section.id }} .e2f-stat-label {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #e2f-collabs-{{ section.id }} *,
    #e2f-collabs-{{ section.id }} *::before,
    #e2f-collabs-{{ section.id }} *::after {
      transition: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "E2F — Collaborations",
  "tag": "section",
  "class": "e2f-collaborations-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Afficher l'en-tête",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Esprit2'FOOT"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Texte alternatif du logo",
      "default": "Esprit2'FOOT"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largeur du logo",
      "min": 60,
      "max": 350,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texte à afficher si aucun logo n'est importé",
      "default": "ESPRIT2'FOOT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "NOS COLLABORATIONS"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "<p>Ils portent nos couleurs. Découvrez les créateurs qui font vivre Esprit2'FOOT.</p>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texte d'introduction",
      "default": "<p>Retrouve leurs vidéos, leurs tests et leurs collaborations autour du football.</p>"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Texte de bas de section"
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Casse du titre",
      "options": [
        { "value": "uppercase", "label": "MAJUSCULES" },
        { "value": "none", "label": "Texte normal" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille maximale du titre",
      "min": 30,
      "max": 76,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Largeur du trait turquoise",
      "min": 30,
      "max": 180,
      "step": 10,
      "unit": "px",
      "default": 90
    },
    {
      "type": "header",
      "content": "Disposition des cartes"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "options": [
        { "value": "2", "label": "2 colonnes" },
        { "value": "3", "label": "3 colonnes" },
        { "value": "4", "label": "4 colonnes" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes sur mobile",
      "options": [
        { "value": "1", "label": "1 colonne" },
        { "value": "2", "label": "2 colonnes" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Format des miniatures",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Carré" },
        { "value": "16 / 9", "label": "Paysage" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espace entre les cartes",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale de la section",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Arrondi des cartes",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Ombre sur les cartes",
      "default": true
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arrondi des boutons",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Statistiques et icônes du bas"
    },
    {
      "type": "select",
      "id": "stats_columns",
      "label": "Colonnes des statistiques",
      "options": [
        { "value": "2", "label": "2 colonnes" },
        { "value": "3", "label": "3 colonnes" },
        { "value": "4", "label": "4 colonnes" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "stats_margin",
      "label": "Espace avant les statistiques",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "stats_icon_size",
      "label": "Taille des icônes des statistiques",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "stats_value_size",
      "label": "Taille des chiffres",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "color",
      "id": "stats_text_color",
      "label": "Couleur du texte des statistiques",
      "default": "#050505"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
