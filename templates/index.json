    "media_with_text_98C7FQ": {
      "type": "media-with-text",
      "blocks": {
        "image_48MKJB": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/8443e5a9-f59f-47a6-8cf0-50c8c88d7a3b.png",
            "media_width": 45,
            "media_position": "start",
